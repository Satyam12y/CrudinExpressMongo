<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Contact Details</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
</head>

<body>

    <div class="container mt-5">
        <div class="card shadow-lg" style="max-width: 700px; margin:auto;">

            <div class="card-header bg-primary text-white">
                <h4 class="mb-0">Contact Details</h4>
            </div>

            <div class="card-body">

                <div class="mb-3">
                    <strong>First Name:</strong> Satyam
                </div>

                <div class="mb-3">
                    <strong>Last Name:</strong> Singh Yadav
                </div>

                <div class="mb-3">
                    <strong>Email:</strong> satyam@example.com
                </div>

                <div class="mb-3">
                    <strong>Mobile:</strong> 9876543210
                </div>

                <div class="mb-3">
                    <strong>Age:</strong> 25
                </div>

                <div class="mb-4">
                    <strong>Address:</strong> Lucknow, Uttar Pradesh
                </div>

                <div class="d-flex gap-2">

                    <a href="/update-contact" class="btn btn-warning">
                        <i class="bi bi-pencil-fill"></i> Edit
                    </a>

                    <a href="/delete-contact/<%= contact._id %>" class="btn btn-danger">
                        <i class="bi bi-trash3-fill"></i> Delete
                    </a>

                    <a href="/" class="btn btn-secondary">
                        <i class="bi bi-x-circle"></i> Cancel
                    </a>

                </div>

            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>

</body>

</html>